      { "id": "arena_heroes",    "kind": "arena",    "name": "Арена героев",     "level": 6, "castle": 10, "ai": "warlord",   "xpPct": 300, "map": "map.highvale_01", "resetGems": 60 },
      { "id": "monument_frost",  "kind": "monument", "name": "Монумент Инея",    "level": 7, "castle": 13, "shards": 3, "map": "map.mountain_01", "resetGems": 80 },
      { "id": "arena_titans",    "kind": "arena",    "name": "Арена титанов",    "level": 8, "castle": 15, "ai": "nightmare", "xpPct": 300, "map": "map.highvale_01", "resetGems": 100 },
