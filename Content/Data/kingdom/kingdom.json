{
  "schemaVersion": 1,
  // Kingdom rules. Values marked "wiki" come from the original game (docs/Original_Reference.md),
  // the rest are our estimates until we can check them against the live game.
  "grid": { "width": 40, "height": 40 },

  // City expansions: the first is open from the start, the rest cost gold (wiki: 33 000, 307 000, 1 431 000).
  // Areas are tile rectangles [x0, y0, x1, y1). The Castle level gates are estimates.
  "expansions": [
    { "costGold": 0,       "castle": 1,  "area": [8, 8, 32, 32] },
    { "costGold": 33000,   "castle": 4,  "area": [5, 5, 35, 35] },
    { "costGold": 307000,  "castle": 9,  "area": [2, 2, 38, 38] },
    { "costGold": 1431000, "castle": 14, "area": [0, 0, 40, 40] }
  ],

  // Portal stones (wiki): one stone every 7 minutes, a raid costs 3, a capture 6.
  "portal": { "regenSec": 420, "raidCost": 3, "captureCost": 6, "gemsPerStone": 4 },

  // Lands (wiki): gold, farm, ruins (shards) and victory-point lands (forest, lake, mountain).
  // Gold and farm lands fill up in 6 h at level 1, 15 h at level 5, 24 h from level 9; VP lands in 4 h (wiki).
  // Gold land level 1 produces 180 per hour (wiki); the growth per level is an estimate.
  // Captured ruins ("shard plinths") make 1 shard per 24 hours (wiki, version 1.8); they hold 3 (estimate).
  // VP land production, the Castle level at which each type appears and how often (weight) are estimates.
  // A titan on a land adds 1% production per titan level (wiki). Max 30 lands; slots beyond the
  // Castle's land capacity cost gems (price is an estimate).
  // "map", "field" and "swap" are read by the clients: the battlefield of the land (the layouts are ours) and how
  // its defenders differ (wiki 1.8: defender troop combinations depend on the land type; which troops is ours).
  "lands": {
    "maxLands": 30,
    "extraSlotGems": [300, 600, 900, 1200, 1500, 2000, 2500, 3000, 3500, 4000],
    "fillHours": [6, 7, 9, 12, 15, 17, 19, 21, 24],
    "types": [
      { "id": "gold_land", "name": "Золотая земля", "resource": "gold", "produce": [180, 230, 300, 390, 500, 650, 840, 1090, 1420], "weight": 30 },
      { "id": "farm_land", "name": "Фермерская земля", "resource": "food", "produce": [180, 230, 300, 390, 500, 650, 840, 1090, 1420], "weight": 30 },
      { "id": "forest", "name": "Лес", "resource": "vp", "castle": 3, "weight": 8, "produce": [5, 6, 7, 8, 10, 12, 14, 16, 20], "fillHours": [4],
        "raidLoot": [30, 36, 42, 48, 60, 72, 84, 96, 120], "map": "map.forest_01", "field": "Чаща", "fieldNote": "леса по флангам укрывают отряды, в центре дорога и холм", "swap": { "troop.knights": "troop.swordsmen", "troop.outriders": "troop.archers" } },
      { "id": "lake", "name": "Озеро", "resource": "vp", "castle": 3, "weight": 8, "produce": [5, 6, 7, 8, 10, 12, 14, 16, 20], "fillHours": [4],
        "raidLoot": [30, 36, 42, 48, 60, 72, 84, 96, 120], "map": "map.lake_01", "field": "Зеркальное озеро", "fieldNote": "глубокая вода посередине, через неё один брод", "swap": { "troop.outriders": "troop.archers", "troop.panthers": "troop.pikemen" } },
      { "id": "mountain", "name": "Гора", "resource": "vp", "castle": 3, "weight": 8, "produce": [5, 6, 7, 8, 10, 12, 14, 16, 20], "fillHours": [4],
        "raidLoot": [30, 36, 42, 48, 60, 72, 84, 96, 120], "map": "map.mountain_01", "field": "Перевал", "fieldNote": "высоты и скалы с боков, проход по центру", "swap": { "troop.militia": "troop.spearmen", "troop.knights": "troop.swordsmen", "troop.panthers": "troop.goliaths", "troop.grenadiers": "troop.ballista" } },
      { "id": "ruins", "name": "Руины", "resource": "shards", "castle": 5, "weight": 10, "periodHours": 24, "produce": [1, 1, 1, 1, 1, 1, 1, 1, 1], "fillHours": [72],
        "raidLoot": [1, 1, 1, 1, 2, 2, 2, 3, 3], "map": "map.ruins_01", "field": "Павший город", "fieldNote": "в развалинах стрелки получают меньше урона", "swap": { "troop.militia": "troop.archers" } }
    ],
    // Loot for a 3-star raid by land level (estimate), in the land's own resource (wiki 1.8: a gold land
    // rewards gold, a farm land food); 2 stars give 75%, 1 star 50%.
    "raidLoot": [2400, 5200, 9200, 14800, 22000, 32000, 44000, 60000, 80000],
    // VP for any won land battle by land level, scaled by stars like loot (wiki: VP for almost all victories;
    // the amounts are estimates).
    "victoryVp": [4, 6, 8, 10, 13, 16, 20, 25, 30],
    "worldSize": 8,
    // Upgrading a captured land (guides: upgrade lands to raise their output). The original's prices are unknown;
    // these are estimates. Gold and hours by the level reached. A builder works on it, the land keeps producing at its
    // old level meanwhile, and it goes no higher than the top of the level band the Castle opens on the world map.
    // A level that would produce no more (ruins) is not offered.
    "upgradeGold": [0, 4000, 9000, 25000, 60000, 130000, 260000, 480000, 800000],
    "upgradeHours": [0, 1, 2, 4, 8, 12, 18, 24, 36]
  },

  // The world map. The original: every kingdom is an island with its captured lands floating around it, so a glance
  // tells how strong a player is; between them float neutral lands and sites; a land is targeted by tapping it. Until
  // there is a server the other kingdoms are computer lords. Ours: the lords, their Castle against the player's, how
  // many lands they hold, how long a taken land takes to come back and a raided one stays shielded, the extra loot and
  // VP their lands give, and the level of the lord's titan that guards every one of their lands, by land level (rarity
  // by the lord's Castle). All of it is our estimate; the titan levels are fitted on the sim so that a typical kingdom
  // wins 75-100% on lords' lands of its own level band and about half on the strongest neighbour's top land.
  "rivals": {
    "castle": 3,
    "castleOffsets": [-1, 0, 0, 1, 2],
    "lands": { "base": 2, "perCastle": 6, "max": 4 },
    "regrowHours": 8,
    "shieldHours": 8,
    "lootPct": 150,
    "vpPct": 150,
    "titanLevels": [5, 8, 11, 14, 16, 22, 28, 36, 40],
    "lords": [
      { "name": "Лорд Вейран",      "realm": "Северная марка" },
      { "name": "Леди Исмена",      "realm": "Янтарный берег" },
      { "name": "Ярл Хродгар",      "realm": "Вороний фьорд" },
      { "name": "Князь Осмунд",     "realm": "Серые холмы" },
      { "name": "Королева Мираэль", "realm": "Лунная долина" },
      { "name": "Барон Гаррик",     "realm": "Ржавые копи" },
      { "name": "Леди Сельвина",    "realm": "Туманные топи" },
      { "name": "Тан Бруннар",      "realm": "Каменный предел" }
    ]
  },

  // Raids on the kingdom. The original (wiki, guides): the city and captured lands have default defenses that the player
  // reinforces with titans and troops (Garrison), a lost defense gives a shield, reserves keep part of the gold and food
  // from raiders, a raid on the Garrison takes 5% of the defender's VP (1.8). There the raiders are other players; until
  // there is a server they are AI raiders, and they also come while the game is closed (the player's choice, 2026-10-28).
  // Everything except the 5% is our estimate. Raiders come at a level of the band the Castle opens on the world map and
  // bring that level's land battle army ("battles" below): on the city citySquads squads by level, on a land as many as
  // the row has. A land defends with the army of its own level, so upgrading it strengthens the defense.
  "raids": {
    "castle": 3,
    "firstHours": 24,
    "everyHours": [6, 10],
    "awayHours": 48,
    "cityPct": 40,
    "cityShieldHours": 12,
    "landShieldHours": 12,
    // Of the gold and food above the reserves; of VP; of what a land holds. At three stars; 2 stars 75%, 1 star 50%.
    "stealPct": 20,
    "vpPct": 5,
    "landStealPct": 100,
    // A held defense gives this share of a land battle's VP at the raiders' level.
    "defenseVpPct": 50,
    "citySquads": [3, 4, 4, 5, 5, 6, 6, 7, 8],
    // Raiders are players in the original, so they always bring a titan: its level by the raiders' level (rarity R1 to
    // level 3, R1-R2 to 6, R2-R3 to 8, then R3-R4).
    "titanLevels": [6, 9, 12, 15, 18, 22, 28, 34, 40],
    // The Garrison's own guards stand in its empty slots (tier by Garrison level in buildings.json); without a Garrison
    // the city has noGarrisonSlots of them.
    "guards": ["troop.militia", "troop.spearmen", "troop.archers"],
    "noGarrisonSlots": 2,
    "noGarrisonTier": 1,
    "defenderAi": "veteran",
    // How a raid goes, fitted by maximum likelihood to 4 000 simulated battles of raid-like armies (raiders of every
    // level against random defenses): each side's power is the battle's own start power with titans counted
    // titanPct %, the raiders' scaled by their AI; at ratio x = raiders / defense they win with x^k / (x^k + c^k)
    // (c in hundredths). When they win, they take three stars from threeStars (hundredths of x), two below that, one
    // below twoStars if a titan defends (as in battle: without a defending titan its star comes with the first).
    "odds": { "titanPct": 590, "aiPct": { "recruit": 89, "veteran": 100, "warlord": 145, "nightmare": 216 },
              "k": 4.5, "c": 103, "threeStars": 90, "twoStars": 50 },
    "log": 10
  },

  // Seasons (wiki, Leagues): VP ranks players and alliances; at the end of a season everyone's VP returns to zero
  // and rewards follow the result; leagues are ranked every week (wiki, 1.8). The original ranks alliances in
  // leagues with promotion and relegation; until alliances arrive, the league here is personal and set by the
  // season's VP. League names, thresholds and rewards (gems and portal stones, as in the original) are ours.
  // Seasons start on Mondays 00:00 UTC.
  "seasons": {
    "epoch": 1736121600,
    "days": 7,
    "leagues": [
      { "id": "bronze",   "name": "Бронзовая лига",   "vp": 100,   "gems": 20,  "stones": 6 },
      { "id": "silver",   "name": "Серебряная лига",  "vp": 400,   "gems": 40,  "stones": 9 },
      { "id": "gold",     "name": "Золотая лига",     "vp": 1000,  "gems": 80,  "stones": 12 },
      { "id": "platinum", "name": "Платиновая лига",  "vp": 2500,  "gems": 150, "stones": 18 },
      { "id": "diamond",  "name": "Алмазная лига",    "vp": 6000,  "gems": 300, "stones": 24 },
      { "id": "titan",    "name": "Лига титанов",     "vp": 15000, "gems": 500, "stones": 30 }
    ]
  },

  // Alliances. From the original: a player may join one at 1 000 VP (guides: Level Winner, Touch Tap Play); members'
  // VP count for themselves and for the alliance (wiki, Announcements); alliances meet in leagues ranked every week,
  // the best go up and the worst go down, and every member is paid by the alliance's result: gems, portal stones and a
  // crystal of rarity 1-4 with a relic or sometimes a titan; crystal rarity grows with the league, rarity 4 only in the
  // top ones, and a higher place gives a better chance of a titan (wiki: Leagues, Announcements). Allies send troops
  // to the Alliance Camp: they fight in one battle, and the camp's level sets how many (wiki: Troops, Announcements).
  // There is no server yet, so the other alliances and their members are computer players: their weekly VP follow
  // from the kingdom's seed and the alliance's strength. Everything below that the original does not give is ours:
  // the names, group size, how many go up and down, the rewards by place, the requirements of strong alliances,
  // creating an alliance (100 gems, master prompt 12.1), recruits of an own alliance, a day in the alliance before
  // its reward is paid, the request cooldown (20 min, master prompt 12.6) and the level of the troops allies send.
  "alliances": {
    "joinVp": 1000,
    "createGems": 100,
    "members": [8, 30],
    "groupSize": 8,
    "promote": 2,
    "memberHours": 24,
    "recruitHours": 6,
    "recruits": 24,
    "placeStepPct": 10,
    "minPlacePct": 30,
    "crystalGems": [20, 40, 80, 160],
    "reinforceCooldownSec": 1200,
    "reinforceArriveSec": 60,
    // memberVp: weekly VP of a computer member, by its alliance's strength; joinVp of an alliance grows with its
    // strength (1.5 × the strength, rounded down to 500, from joinVp up to joinVpMax); gems and stones are for first
    // place; titanPct is the crystal's titan chance for first and last place; troopLevel is what allies send.
    "joinVpMax": 8000,
    "leagues": [
      { "id": "bronze",   "name": "Бронзовая лига",  "memberVp": [150, 500],   "gems": 100, "stones": 9,  "crystal": 1, "titanPct": [30, 10], "troopLevel": 3 },
      { "id": "silver",   "name": "Серебряная лига", "memberVp": [300, 900],   "gems": 150, "stones": 12, "crystal": 2, "titanPct": [25, 8],  "troopLevel": 5 },
      { "id": "gold",     "name": "Золотая лига",    "memberVp": [600, 1600],  "gems": 220, "stones": 15, "crystal": 2, "titanPct": [20, 6],  "troopLevel": 7 },
      { "id": "platinum", "name": "Платиновая лига", "memberVp": [1200, 3000], "gems": 320, "stones": 18, "crystal": 3, "titanPct": [15, 5],  "troopLevel": 9 },
      { "id": "diamond",  "name": "Алмазная лига",   "memberVp": [2500, 6000], "gems": 450, "stones": 24, "crystal": 3, "titanPct": [12, 4],  "troopLevel": 12 },
      { "id": "titan",    "name": "Лига титанов",    "memberVp": [5000, 12000],"gems": 650, "stones": 30, "crystal": 4, "titanPct": [8, 2],   "troopLevel": 15 }
    ],
    // Computer alliances: name and tag. There are groupSize of them per league at the start.
    "names": [
      ["Сыны Грома", "ГРОМ"], ["Стражи Рассвета", "ЗАРЯ"], ["Пепельные Волки", "ВОЛК"], ["Железный Венец", "ВЕНЕЦ"],
      ["Дети Бури", "БУРЯ"], ["Каменные Клыки", "КЛЫК"], ["Северный Щит", "ЩИТ"], ["Орден Феникса", "ФНКС"],
      ["Багровый Рог", "РОГ"], ["Звёздные Странники", "ЗВЁЗД"], ["Тени Ущелья", "ТЕНЬ"], ["Морской Змей", "ЗМЕЙ"],
      ["Золотая Грива", "ГРИВА"], ["Последний Бастион", "БАСТ"], ["Древние Корни", "КОРНИ"], ["Ледяная Корона", "ЛЁД"],
      ["Кузня Титанов", "КУЗНЯ"], ["Чёрный Ворон", "ВОРОН"], ["Братство Секиры", "ТОПОР"], ["Вечный Огонь", "ОГОНЬ"],
      ["Небесный Молот", "МОЛОТ"], ["Песчаная Буря", "ПЕСОК"], ["Дом Медведя", "МЕДВ"], ["Клинки Заката", "ЗАКАТ"],
      ["Хранители Рун", "РУНА"], ["Гнев Олимпа", "ОЛИМП"], ["Сердце Горы", "ГОРА"], ["Полуночные Всадники", "НОЧЬ"],
      ["Белый Олень", "ОЛЕНЬ"], ["Медные Легионы", "ЛЕГИ"], ["Шёпот Леса", "ЛЕС"], ["Острова Туманов", "ТУМАН"],
